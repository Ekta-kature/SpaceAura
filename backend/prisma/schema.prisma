generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum ProjectStatus {
  INQUIRY
  CONSULTATION
  DESIGN
  EXECUTION
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  NEW
  REPLIED
  CONSULTATION_BOOKED
  CONVERTED
  CLOSED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String?
  name         String
  phone        String?
  city         String?
  avatar       String?
  role         Role     @default(CUSTOMER)
  googleId     String?  @unique
  isVerified   Boolean  @default(false)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders        Order[]
  wishlist      WishlistItem[]
  cart          CartItem[]
  reviews       Review[]
  projects      Project[]      @relation("CustomerProjects")
  conversations Conversation[] @relation("UserConversations")
  messages      Message[]      @relation("SentMessages")
  vendor        Vendor?
  addresses     Address[]

  @@map("users")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String   @default("Home")
  street    String
  landmark  String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

model Vendor {
  id               String   @id @default(uuid())
  userId           String   @unique
  businessName     String
  specialty        String
  bio              String?
  experience       Int      @default(1)
  location         String
  consultationFee  Float    @default(2000)
  isVerified       Boolean  @default(false)
  portfolioWebsite String?
  instagram        String?
  coverImage       String?
  styles           String[]
  rating           Float    @default(0)
  totalReviews     Int      @default(0)
  totalProjects    Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioImages  PortfolioImage[]
  products         Product[]
  projects         Project[]         @relation("VendorProjects")
  leads            Lead[]
  consultations    Consultation[]
  reviews          Review[]

  @@map("vendors")
}

model PortfolioImage {
  id        String   @id @default(uuid())
  vendorId  String
  url       String
  caption   String?
  roomType  String?
  style     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("portfolio_images")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  image       String?
  description String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  createdAt   DateTime   @default(now())

  @@map("categories")
}

model Product {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String
  price        Float
  oldPrice     Float?
  badge        String?
  categoryId   String
  vendorId     String?
  rating       Float    @default(0)
  totalReviews Int      @default(0)
  stock        Int      @default(100)
  isActive     Boolean  @default(true)
  specs        Json?
  tags         String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  images        ProductImage[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]

  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  isPrimary Boolean @default(false)
  order     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  qty       Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String
  addressId       String?
  status          OrderStatus @default(PENDING)
  subtotal        Float
  gst             Float
  deliveryCharge  Float       @default(0)
  total           Float
  promoCode       String?
  discount        Float       @default(0)
  paymentId       String?
  razorpayOrderId String?
  paymentStatus   String      @default("pending")
  deliveryType    String      @default("standard")
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User       @relation(fields: [userId], references: [id])
  address Address?   @relation(fields: [addressId], references: [id])
  items   OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  name      String
  price     Float
  qty       Int
  imageUrl  String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  productId  String?
  vendorId   String?
  rating     Int
  title      String?
  comment    String
  images     String[]
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  vendor  Vendor?  @relation(fields: [vendorId], references: [id])

  @@map("reviews")
}

model Project {
  id          String        @id @default(uuid())
  customerId  String
  vendorId    String
  title       String
  roomType    String
  budget      Float?
  status      ProjectStatus @default(INQUIRY)
  description String?
  phase       Int           @default(1)
  progress    Float         @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer     User          @relation("CustomerProjects", fields: [customerId], references: [id])
  vendor       Vendor        @relation("VendorProjects", fields: [vendorId], references: [id])
  milestones   Milestone[]
  conversation Conversation?

  @@map("projects")
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String?
  isDone      Boolean   @default(false)
  dueDate     DateTime?
  completedAt DateTime?
  order       Int       @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model Lead {
  id        String     @id @default(uuid())
  vendorId  String
  name      String
  email     String
  phone     String?
  city      String?
  roomType  String?
  budget    String?
  message   String?
  status    LeadStatus @default(NEW)
  source    String     @default("website")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("leads")
}

model Consultation {
  id            String   @id @default(uuid())
  vendorId      String
  customerName  String
  customerEmail String
  customerPhone String?
  date          DateTime
  meetingType   String   @default("video")
  message       String?
  isPaid        Boolean  @default(false)
  paymentId     String?
  amount        Float
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@map("consultations")
}

model Conversation {
  id        String   @id @default(uuid())
  projectId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project?  @relation(fields: [projectId], references: [id])
  participants User[]    @relation("UserConversations")
  messages     Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  type           String   @default("TEXT")
  fileUrl        String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@map("messages")
}

model Design {
  id          String   @id @default(uuid())
  title       String
  category    String
  style       String
  designer    String
  location    String
  imageUrl    String
  priceMin    Float?
  priceMax    Float?
  sqft        Int?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("designs")
}

model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Float?
  discountAmount  Float?
  minOrderValue   Float     @default(0)
  maxUses         Int?
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@map("promo_codes")
}

model Newsletter {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("newsletter")
}
